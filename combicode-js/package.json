{
  "name": "combicode",
  "version": "3.0.0",
  "description": "A CLI tool to combine a project's codebase into a single file for LLM context.",
  "main": "index.js",
  "bin": {
    "combicode": "index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.js",
    "format": "prettier --write index.js lib test",
    "format:check": "prettier --check index.js lib test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaurelions/combicode.git"
  },
  "keywords": [
    "cli",
    "llm",
    "ai",
    "context",
    "prompt",
    "developer-tool",
    "codegen",
    "chatgpt",
    "llms.txt",
    "llms",
    "llms-full.txt"
  ],
  "author": "A. Aurelions",
  "license": "MIT",
  "dependencies": {
    "ignore": "^7.0.9",
    "yargs": "^18.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "index.js",
    "lib/",
    "ignore.json",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
